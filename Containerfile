ARG BASE_VERSION=15
FROM ghcr.io/daemonless/base-rcd:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG UPSTREAM_URL="https://fw-update.ui.com/api/firmware-latest?filter=eq~~product~~unifi-os-server&filter=eq~~channel~~release"
ARG HEALTHCHECK_ENDPOINT="https://localhost:443/api/2.0/login"

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

LABEL org.opencontainers.image.title="UniFi OS Server" \
    org.opencontainers.image.description="Highly experimental: Ubiquiti UniFi OS Server on FreeBSD — runs the full UniFi management stack (unifi-core, UniFi Network) using FreeBSD jails and linuxulator." \
    org.opencontainers.image.source="https://github.com/daemonless/unifi-os-server" \
    org.opencontainers.image.url="https://ui.com/" \
    org.opencontainers.image.documentation="https://help.ui.com/hc/en-us/categories/200320654" \
    org.opencontainers.image.licenses="Proprietary" \
    org.opencontainers.image.vendor="daemonless" \
    org.opencontainers.image.authors="daemonless" \
    io.daemonless.arch="${FREEBSD_ARCH}" \
    io.daemonless.category="Network" \
    io.daemonless.upstream-url="${UPSTREAM_URL}" \
    io.daemonless.upstream-jq='._embedded.firmware[] | select(.platform=="linux-x64") | .version | ltrimstr("v")' \
    io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}"

# Step 1: FreeBSD native packages
# - linux_base-rl9: Linux compat environment (glibc, basic libs)
# - postgresql14-server: DB for unifi-core, ulp-go, uid-agent (14 matches Debian bullseye; PG15+ breaks ulp-go migration SQL)
# - nginx: Frontend reverse proxy (managed by unifi-core)
# - openjdk25-headless: UniFi Network application (ace.jar classfile 69)
# - python3: Used during build to extract OCI layers
ARG PACKAGES="linux_base-rl9 postgresql14-server mongodb70 nginx openjdk25-headless python3"
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Step 2: Enable Linux binary compatibility
RUN if command -v sysrc >/dev/null 2>&1; then sysrc linux_enable=YES; fi && \
    (kldload linux64 2>/dev/null || true) && \
    (mount -t linprocfs linprocfs /compat/linux/proc 2>/dev/null || true) && \
    (mount -t linsysfs linsysfs /compat/linux/sys 2>/dev/null || true)

# Step 3: Download UOS Server installer and extract OCI image layers.
# uos-extract.py handles: embedded ZIP → image.tar → OCI layer extraction.
# The COPY of root/ happens later, so we copy the script explicitly here first.
COPY root/usr/local/bin/uos-extract.py /usr/local/bin/uos-extract.py
RUN API_RESPONSE=$(fetch -qo - "${UPSTREAM_URL}") && \
    UOS_VERSION=$(echo "$API_RESPONSE" | python3 -c 'import json,sys; fws=json.load(sys.stdin)["_embedded"]["firmware"]; print(next(f["version"] for f in fws if f["platform"]=="linux-x64").lstrip("v"))') && \
    INSTALLER_URL=$(echo "$API_RESPONSE" | python3 -c 'import json,sys; fws=json.load(sys.stdin)["_embedded"]["firmware"]; print(next(f["_links"]["data"]["href"] for f in fws if f["platform"]=="linux-x64"))') && \
    mkdir -p /app && echo "${UOS_VERSION}" > /app/version && \
    if [ ! -f /var/tmp/uos-installer ]; then \
        echo "Downloading UniFi OS Server ${UOS_VERSION}..." && \
        fetch -qo /var/tmp/uos-installer "${INSTALLER_URL}"; \
    else \
        echo "Using pre-downloaded installer at /var/tmp/uos-installer"; \
    fi && \
    python3 /usr/local/bin/uos-extract.py && \
    rm /var/tmp/uos-installer 2>/dev/null || true

# Steps 4-12: Install files from UOS rootfs and cleanup in a single layer.
# Keeping extract + copy + rm in one RUN prevents the rootfs (~800MB) from
# being committed as an intermediate layer.
RUN \
    # Linux shared libs for dbus-daemon (not in linux_base-rl9)
    mkdir -p /compat/linux/usr/lib64 && \
    cp /var/tmp/uos-rootfs/usr/lib/x86_64-linux-gnu/libsystemd.so.0* /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/usr/lib/x86_64-linux-gnu/libapparmor.so.1 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/usr/lib/x86_64-linux-gnu/liblz4.so.1 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/usr/lib/x86_64-linux-gnu/libgcrypt.so.20 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/usr/lib/x86_64-linux-gnu/libssl.so.1.1 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/usr/lib/x86_64-linux-gnu/libcrypto.so.1.1 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/lib/x86_64-linux-gnu/libaudit.so.1 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/lib/x86_64-linux-gnu/libcap-ng.so.0 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/lib/x86_64-linux-gnu/libdbus-1.so.3 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/lib/x86_64-linux-gnu/libexpat.so.1 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/lib/x86_64-linux-gnu/liblzma.so.5 /compat/linux/usr/lib64/ && \
    cp /var/tmp/uos-rootfs/lib/x86_64-linux-gnu/libgpg-error.so.0 /compat/linux/usr/lib64/ && \
    \
    # Linux binaries (run via linuxulator at runtime)
    # node24: unifi-core JS runtime; dbus-daemon: uos-agent IPC (session mode)
    cp /var/tmp/uos-rootfs/usr/bin/node24 /usr/local/bin/unifi-node && \
    cp /var/tmp/uos-rootfs/usr/bin/dbus-daemon /usr/local/bin/dbus-daemon && \
    cp /var/tmp/uos-rootfs/usr/bin/uos-agent /usr/local/bin/uos-agent && \
    \
    # Go services (statically linked against glibc, run directly on FreeBSD)
    cp /var/tmp/uos-rootfs/usr/sbin/ulp-go-app /usr/local/bin/ulp-go-app && \
    cp /var/tmp/uos-rootfs/usr/sbin/uid-agent-app /usr/local/bin/uid-agent-app && \
    \
    # unifi-core app, assets, and dbus service definitions
    cp -r /var/tmp/uos-rootfs/usr/share/unifi-core /usr/share/ && \
    cp -r /var/tmp/uos-rootfs/usr/share/unifi-assets /usr/share/ && \
    cp -r /var/tmp/uos-rootfs/usr/share/dbus-1 /usr/share/ && \
    \
    # ulp-go and uid-agent config/schema files
    cp -r /var/tmp/uos-rootfs/usr/lib/ulp-go /usr/lib/ && \
    cp -r /var/tmp/uos-rootfs/usr/lib/uid-agent /usr/lib/ && \
    \
    # UniFi Network (ace.jar)
    mkdir -p /usr/share/unifi && \
    cp -rP /var/tmp/uos-rootfs/usr/lib/unifi/* /usr/share/unifi/ && \
    rm -f /usr/share/unifi/bin/mongod && \
    ln -s /usr/local/bin/mongod /usr/share/unifi/bin/mongod && \
    \
    # OS metadata: unifi-core checks VERSION_CODENAME=bullseye and /usr/lib/version
    echo "VERSION_CODENAME=bullseye" >> /compat/linux/etc/os-release && \
    UOS_VERSION=$(cat /app/version) && \
    echo "UOSSERVER.unifi-os.v${UOS_VERSION}.bullseye.$(date +%y%m%d).$(date +%H%M)" > /usr/lib/version && \
    \
    # sudo stub: unifi-core calls "sudo -E -u unifi-core node ..."; we drop the flag.
    # Written to BOTH compat paths — truss confirmed the app-install/restore
    # flow resolves the bare Linux ELF process's PATH to /usr/bin/sudo, not
    # /usr/local/bin/sudo, while other callers use the latter. Also install
    # natively (/usr/local/bin/sudo) for FreeBSD-side callers.
    mkdir -p /compat/linux/usr/local/bin /compat/linux/usr/bin && \
    printf '#!/bin/sh\nwhile [ $# -gt 0 ]; do\n  case "$1" in\n    -E|-n) shift ;;\n    -u) shift; shift ;;\n    --) shift; break ;;\n    -*) shift ;;\n    *) break ;;\n  esac\ndone\nexec "$@"\n' \
        | tee /compat/linux/usr/local/bin/sudo /compat/linux/usr/bin/sudo /usr/local/bin/sudo > /dev/null && \
    chmod 755 /compat/linux/usr/local/bin/sudo /compat/linux/usr/bin/sudo /usr/local/bin/sudo && \
    \
    # Cleanup — rootfs no longer needed
    rm -rf /var/tmp/uos-rootfs

# Step 3b: Newer standalone Network release over the bundled one (backups refuse
# to restore into an older controller). See uos-network-graft.py.
COPY root/usr/local/bin/uos-network-graft.py /usr/local/bin/uos-network-graft.py
RUN python3 /usr/local/bin/uos-network-graft.py

# Patch unifi-core for FreeBSD linuxulator runtime quirks
RUN python3 -c 'import re; from pathlib import Path; p=Path("/usr/share/unifi-core/app/service.js"); s=p.read_text(); pat=re.compile(r"(\w+)\.installCrashHandler\((\w+\.join\(\w+\.logs\.dir,\"service\"\))\),\1\.setWorkersPoolsLimits_"); repl=r"(()=>{try{\1.installCrashHandler(\2)}catch(e){console.warn(`[unifi-core] disabled webrtc crash handler:`,e.message)}})(),\1.setWorkersPoolsLimits_"; s2,n=pat.subn(repl,s); assert n==1, "crash-handler pattern not found"; p.write_text(s2)'

# Fix CSRF token delivery: auth.conf hands the browser its expected CSRF token via
# the X-Csrf-Token response header, but reads it from $csrf_token_header — a variable
# our nginx.conf can only declare as an empty stub map (real UOS sources it elsewhere).
# Result: the browser gets a blank token, echoes nothing, and EVERY post-setup mutating
# request (settings PUTs, backup restore, checkUpdates, auth/refresh) fails the auth
# subrequest's CSRF check with 403 — the console is effectively read-only. The frontend
# mislabels the backup-restore 403 as "owner mismatch". Point add_header at the variable
# that already holds the real token ($expected_csrf_token, set from the auth server's
# x-expected-csrf-token response header a few lines above).
RUN python3 -c 'from pathlib import Path; p=Path("/usr/share/unifi-core/http/auth.conf"); s=p.read_text(); n=s.count("csrf_token_header"); assert n==1, f"expected 1 csrf_token_header ref in auth.conf, got {n}"; p.write_text(s.replace("csrf_token_header","expected_csrf_token"))'

# Step 13: Set up runtime directories
# PostgreSQL data lives under /data (volume) so it's on host FS, not overlay.
# /run/dbus is created here for the image layer; cont-init recreates it at runtime.
RUN mkdir -p \
        /data/unifi-core/config/http \
        /data/unifi-core/logs \
        /data/ulp-go/log /data/ulp-go/ws /data/ulp-go/tmp \
        /data/uid/log \
        /data/uos \
        /data/unifi/logs \
        /run/dbus && \
    chown -R bsd:bsd \
        /data \
        /run/dbus \
        /usr/share/unifi \
        /usr/share/unifi-assets

# Preserve native nginx behind wrappers copied from root/.
RUN mv /usr/local/sbin/nginx /usr/local/sbin/nginx.real

# Copy s6 service scripts, ubnt-tools, nginx config, and health endpoint
COPY root/ /
RUN chmod +x /daemonless/libexec/* /daemonless/init.d/*

RUN chmod +x /usr/local/bin/ubnt-tools /usr/local/bin/ubnt-systool /usr/local/bin/nginx /usr/local/bin/uos-nginx-freebsd-fixups /usr/local/bin/uos-nginx-genconf /usr/local/bin/systemctl /usr/local/bin/uos /usr/local/sbin/nginx /healthz

# Linux compat copies — Linux ELF binaries exec these via linuxulator.
# unifi-core (Linux ELF) resolves bare command names against its own PATH,
# which under linuxulator maps to /compat/linux/usr/bin AND
# /compat/linux/usr/local/bin depending on the specific caller — confirmed
# via truss: linux_execve("/usr/bin/sudo", ...). Both locations must exist
# for uos/systemctl too, or the app-install/restore flow fails with ENOENT.
RUN mkdir -p /compat/linux/usr/local/bin /compat/linux/usr/bin && \
    ln -sf /usr/local/bin/ubnt-tools /compat/linux/usr/local/bin/ubnt-tools && \
    ln -sf /usr/local/bin/ubnt-systool /compat/linux/usr/local/bin/ubnt-systool && \
    ln -sf /usr/local/bin/nginx /compat/linux/usr/local/bin/nginx && \
    cp /usr/local/bin/systemctl /compat/linux/usr/local/bin/systemctl && \
    cp /usr/local/bin/systemctl /compat/linux/usr/bin/systemctl && \
    cp /usr/local/bin/uos /compat/linux/usr/local/bin/uos && \
    cp /usr/local/bin/uos /compat/linux/usr/bin/uos && \
    chmod 755 /compat/linux/usr/local/bin/systemctl /compat/linux/usr/bin/systemctl \
        /compat/linux/usr/local/bin/uos /compat/linux/usr/bin/uos

# UniFi OS Server ports:
# 443   - HTTPS Web UI (unifi-core via nginx)
# 8080  - UniFi device inform (unifi-network)
# 8443  - UniFi HTTPS (unifi-network direct)
# 6789  - Mobile throughput test
# 3478/udp - STUN
VOLUME /data /compat/linux/data