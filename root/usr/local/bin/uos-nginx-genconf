#!/bin/sh
# Generate /usr/local/etc/nginx/nginx.conf for the current console state.
# Pre-setup:  serve the uhd-setup wizard via the static site-setup template.
# Post-setup: unifi-core generates site-*.conf (site-local-ip serves the
#             unifi-portal shell) — include those instead.
# Called from the nginx s6 run script and from the nginx wrapper on every
# unifi-core initiated reload, so the switch happens when setup completes.

HTTPDIR=/data/unifi-core/config/http

if [ -f "$HTTPDIR/site-local-ip.conf" ]; then
    SITE_INCLUDES="include $HTTPDIR/site-*.conf;"
else
    SITE_INCLUDES="include /usr/share/unifi-core/http/site-setup.uosserver.conf;
    include $HTTPDIR/site-supervisor.conf;"
fi

mkdir -p /var/cache/nginx/auth
chown -R bsd:bsd /var/cache/nginx 2>/dev/null || true

cat > /usr/local/etc/nginx/nginx.conf << EOF
# Run workers as bsd so they can connect to unifi-core Unix sockets (owned bsd:bsd)
user bsd;
worker_processes auto;
error_log /data/unifi-core/logs/nginx-error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include mime.types;
    default_type application/octet-stream;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 32m;

    # Auth subrequest response cache (post-setup auth.conf references this zone)
    proxy_cache_path /var/cache/nginx/auth levels=1 keys_zone=auth_responses:1m max_size=10m inactive=10s;

    # APM log format expected by unifi-core shared-server-defaults.conf
    log_format apm '\$remote_addr - \$remote_user [\$time_local] "\$request" '
                   '\$status \$body_bytes_sent "\$http_referer" '
                   '"\$http_user_agent" rt=\$request_time';

    # CORS variables (cors.conf uses these in location blocks)
    map \$http_origin \$cors_origin {
        default '';
        ~^https?://.+ \$http_origin;
    }
    map \$cors_origin \$cors_credentials {
        default 'false';
        ~. 'true';
    }

    # WebSocket connection upgrade map
    map \$http_upgrade \$connection_upgrade {
        default upgrade;
        ''      close;
    }
    map \$http_upgrade \$connection_type {
        default '';
        websocket 'WebSocket';
    }

    # Auth variables — normally set via auth_request_set in auth.conf,
    # but \$csrf_token_header is referenced without being declared there.
    # Declare it here so nginx accepts the config; auth_request_set will
    # override it at runtime when the auth subrequest responds.
    map \$host \$csrf_token_header {
        default '';
    }

    # Runnable target passed in X-Target-Runnable header
    map \$http_x_target_runnable \$target_runnable {
        default \$http_x_target_runnable;
        ''      '';
    }

    # Normalized runnable target (post-setup auth.conf references this)
    map \$target_runnable \$target_runnable_normalized {
        default \$target_runnable;
        ''      '';
    }

    # WebSocket origin check — both set to \$http_origin so they always match,
    # effectively allowing any origin (unifi-core handles real auth)
    map \$http_origin \$provided_ws_origin {
        default \$http_origin;
    }
    map \$http_origin \$expected_ws_origin {
        default \$http_origin;
    }

    # WebSocket sub-protocol echo
    map \$http_sec_websocket_protocol \$ws_protocol {
        default \$http_sec_websocket_protocol;
        ''      '';
    }

    # Upstream backends generated by unifi-core
    include $HTTPDIR/upstream-*.conf;

    # Site configs (state-dependent, regenerated on every reload)
    $SITE_INCLUDES
}
EOF
