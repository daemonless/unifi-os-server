#!/bin/sh
# Wrapper for native nginx invocations. The real binary is /usr/local/sbin/nginx.real.
[ -x /usr/local/bin/uos-nginx-freebsd-fixups ] && /usr/local/bin/uos-nginx-freebsd-fixups
if [ "$1" = "-s" ] && [ "$2" = "reload" ] && [ ! -s /var/run/nginx.pid ]; then
    /usr/local/sbin/nginx.real -t >/dev/null 2>&1 || exit $?
    exit 0
fi
exec /usr/local/sbin/nginx.real "$@"
