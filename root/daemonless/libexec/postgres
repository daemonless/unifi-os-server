#!/bin/sh
# PostgreSQL — must start first; all other services depend on it
# Data stored under /data so it persists in the volume (not overlay FS)

PGDATA=/data/postgresql/data

mkdir -p "${PGDATA}" /var/run/postgresql
chown bsd:bsd /data/postgresql "${PGDATA}" /var/run/postgresql
chmod 0700 "${PGDATA}"

# Initialize database cluster on first run
if [ ! -f "${PGDATA}/PG_VERSION" ]; then
    # Remove partial init state if present (e.g. from a crashed first run)
    if [ -n "$(ls -A "${PGDATA}" 2>/dev/null)" ]; then
        echo "[postgres] Removing incomplete data directory..."
        rm -rf "${PGDATA}"
        mkdir -p "${PGDATA}"
        chown bsd:bsd "${PGDATA}"
        chmod 0700 "${PGDATA}"
    fi
    echo "[postgres] Initializing database cluster..."
    dsu bsd \
        /usr/local/bin/initdb -D "${PGDATA}" -E UTF8 --locale=C || exit 1

    # Allow all local connections without password (Unix socket + TCP loopback)
    # unifi-node (Linux ELF) connects via TCP 127.0.0.1:5432, not Unix socket
    echo "local all all trust" >> "${PGDATA}/pg_hba.conf"
    echo "host all all 127.0.0.1/32 trust" >> "${PGDATA}/pg_hba.conf"

    # Start temporarily on /tmp/pg-init (not /var/run/postgresql) so other services
    # don't see it via pg_isready and try to connect before roles are created
    mkdir -p /tmp/pg-init
    chown bsd:bsd /tmp/pg-init
    dsu bsd /usr/local/bin/pg_ctl -D "${PGDATA}" -w start \
        -o "-c listen_addresses='' -c unix_socket_directories=/tmp/pg-init"

    dsu bsd /usr/local/bin/psql -h /tmp/pg-init -d postgres -c \
        "CREATE USER \"unifi-core\" WITH CREATEDB;" 2>/dev/null || true
    dsu bsd /usr/local/bin/psql -h /tmp/pg-init -d postgres -c \
        "CREATE DATABASE \"unifi-core\" OWNER \"unifi-core\";" 2>/dev/null || true

    dsu bsd /usr/local/bin/psql -h /tmp/pg-init -d postgres -c \
        "CREATE USER \"ulp-go\" WITH CREATEDB;" 2>/dev/null || true
    dsu bsd /usr/local/bin/psql -h /tmp/pg-init -d postgres -c \
        "CREATE DATABASE \"ulp-go\" OWNER \"ulp-go\";" 2>/dev/null || true
    dsu bsd /usr/local/bin/psql -h /tmp/pg-init -d postgres -c \
        "CREATE DATABASE \"ulp-go-syslog\" OWNER \"ulp-go\";" 2>/dev/null || true

    # uid-agent config.props uses role "uid" and database "uid"
    dsu bsd /usr/local/bin/psql -h /tmp/pg-init -d postgres -c \
        "CREATE USER \"uid\" WITH CREATEDB;" 2>/dev/null || true
    dsu bsd /usr/local/bin/psql -h /tmp/pg-init -d postgres -c \
        "CREATE DATABASE \"uid\" OWNER \"uid\";" 2>/dev/null || true

    dsu bsd /usr/local/bin/pg_ctl -D "${PGDATA}" -w stop
    echo "[postgres] Database initialized"
fi

echo "[postgres] Starting PostgreSQL..."
exec dsu bsd /usr/local/bin/postgres \
    -D "${PGDATA}" \
    -c listen_addresses="127.0.0.1" \
    -c unix_socket_directories="/var/run/postgresql"
